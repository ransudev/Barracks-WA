# Local development defaults. Vercel's Supabase integration can provide
# POSTGRES_URL automatically; DATABASE_URL remains the local override.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/barracks
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Hosted databases: DATABASE_SSL=true verifies the server certificate. Supabase
# also needs its CA certificate from the project's SSL settings, as PEM text.
# DATABASE_SSL=no-verify encrypts without verifying; use it only temporarily.
# DATABASE_SSL_CA=

# Query limit in milliseconds. Defaults to 30000.
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Used only by npm run db:seed-admin. Keep these values server-only and do not
# expose them through NEXT_PUBLIC_*.
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
