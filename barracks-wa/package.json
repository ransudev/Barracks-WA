{
  "name": "barracks-wa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"!app/api/**\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"!app/api/**\"",
    "test": "node --import ./tests/helpers/css-register.mjs --import tsx --experimental-test-module-mocks --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "db:reset-admin": "tsx scripts/reset-admin-password.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:refresh-demo": "tsx scripts/refresh-demo.ts",
    "db:seed-working-app": "tsx scripts/seed-working-app.ts"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "pg": "^8.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
